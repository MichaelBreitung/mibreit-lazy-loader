{
  "name": "mibreit-lazy-loader",
  "version": "2.2.0",
  "description": "Lazy loading of images and iframes with windowing mechanism",
  "type": "module",
  "main": "lib-cjs/index.cjs",
  "module": "lib/index.js",
  "types": "lib-types",
  "files": [
    "lib",
    "lib-cjs",
    "lib-types"
  ],
  "scripts": {
    "dev": "vite",
    "test": "vitest run --passWithNoTests --exclude 'test/**/*.perf.test.*'",
    "test:perf": "vitest run test/scrollLoader.perf.test.ts",
    "build": "tsc --build --clean && tsc && vite build",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-strip": "^3.0.4",
    "puppeteer": "^22.12.0",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  },
  "author": "Michael Breitung",
  "license": "BSD-2-Clause"
}
